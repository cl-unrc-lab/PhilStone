
/*
This is a version of the mutex problem of psketch: several processes competing for a shared resource, the array cs is used to signaling if the 
corresponding process is in the critical zone, time (T) is set to 2 in this example, thus only two iterations are consideres for each process.
*/

bit sp () { return 1; }

bit main () implements sp {
    int resource=0;
    bit[N] cs = 0;
    fork (int i; N){
        for (int j=0; j<T; j++){
            for (int k=0;k<N;k++){
                if (k!=i)
                   assert !(cs[i] && cs[k]);
            }
            reorder{
                cs[i] = 0;
                cs[i] = 1;
                unlock(resource);
                lock(resource);
            }
        }
    }
    return 1;
}           
